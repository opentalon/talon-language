// Per-tenant adaptive percentile for high-mileage detection. The same
// argument as `tuned_consumption.tln` applies to learned_threshold:
// p95 is a sensible default but not universally right. A tenant whose
// fleet skews heavily toward urban delivery vehicles sees a different
// km-distribution shape than a long-haul carrier; their "high mileage"
// percentile is different too.
//
// `tune against test` searches percentile ∈ [50, 99] and picks the value
// that maximizes F1 against the tenant's labeled high-mileage incidents
// (vehicles that actually needed early intervention).
//
//   ./tln build examples/tuned_high_mileage.tln
//   ./tln test examples/tuned_high_mileage.tln test/tuned_high_mileage.tln.test
//   ./tln explain examples/tuned_high_mileage.tln test/tuned_high_mileage.tln.test

detect "Tuned high mileage" {
  for records where type == "item"
    and category == "Vehicles"
    and status == "active"
    and attr "km" > learned_threshold p95 of attr "km" over last 90 days
  tune against test "labeled_high_mileage"
  flag matching items
  label "{item.name}: {attr.km} km — high on tenant-tuned percentile"
  priority HIGH
}
