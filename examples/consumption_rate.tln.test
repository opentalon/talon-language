// calculate + having example suite.
//
// Run:
//   go build ./cmd/talon
//   ./talon test examples/consumption_rate.tln examples/consumption_rate.tln.test

test "high average consumption flags depots" {
  // usage amounts average (120 + 90 + 150)/3 = 120 > 100 → gate opens,
  // every depot is flagged.
  given {
    record 1 type "depot"
    record 2 type "depot"
    record 10 type "usage"
    attr 10 "amount" 120
    record 11 type "usage"
    attr 11 "amount" 90
    record 12 type "usage"
    attr 12 "amount" 150
  }
  when detect "High average consumption"
  expect {
    flagged 1
    flagged 2
  }
}

test "low average consumption flags nothing" {
  // average (10 + 20)/2 = 15 < 100 → gate closes.
  given {
    record 1 type "depot"
    record 10 type "usage"
    attr 10 "amount" 10
    record 11 type "usage"
    attr 11 "amount" 20
  }
  when detect "High average consumption"
  expect {
    not flagged 1
  }
}

test "recent spike opens the wma gate" {
  // usage series (by id) 60, 90, 200 — newest (200) weighs most, so the
  // weighted rate clears 100 even though the flat mean is ~117.
  given {
    record 1 type "depot"
    record 20 type "usage"
    attr 20 "amount" 60
    record 21 type "usage"
    attr 21 "amount" 90
    record 22 type "usage"
    attr 22 "amount" 200
  }
  when detect "Recent consumption spiking"
  expect {
    flagged 1
  }
}

test "recent slowdown closes the wma gate" {
  // same values reversed — the big number is now oldest and weighs least,
  // so the weighted rate falls below 100.
  given {
    record 1 type "depot"
    record 20 type "usage"
    attr 20 "amount" 200
    record 21 type "usage"
    attr 21 "amount" 90
    record 22 type "usage"
    attr 22 "amount" 60
  }
  when detect "Recent consumption spiking"
  expect {
    not flagged 1
  }
}
