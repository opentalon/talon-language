// Imports shared.tln's defines and uses them in a detect block.
// Compile + test with:
//   ./tln build examples/imports/main.tln
//   ./tln test  examples/imports/main.tln test/imports.tln.test

import "./shared.tln"

detect "Service overdue" {
  for records where is "active_item" and is "due_for_service"
  flag matching items
  label "{item.name}: service overdue"
  priority HIGH
}
