// Classify open vehicles by failure risk using an imported ML module.
//
// The `classify` block draws its training set from a pre-fitted model
// (`using model "fleet.ml.failure_risk"`) instead of a `trained_on` query —
// train-once-reuse, the model analog of a cached `threshold`. The model is
// resolved from the imported `fleet.ml` package; a host could equally serve
// it as a Go-registered model under the same qualified name.
//
// Run:
//   go build ./cmd/tln
//   ./tln test examples/fleet_risk.tln test/fleet_risk.tln.test

import "fleet.ml"

classify "Vehicle failure risk" {
  for records where type == "vehicle" and status == "open"
  using model "fleet.ml.failure_risk"
  confidence >= 0.9
  label "risk: {class}"
  priority HIGH
}
