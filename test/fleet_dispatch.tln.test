// Pareto-frontier dispatch test. Run with:
//
//   ./tln test examples/fleet_dispatch.tln test/fleet_dispatch.tln.test

test "Pareto frontier picks non-dominated vehicles" {
  given {
    record 101 type "item" category "Vehicles" status "active"
    attr 101 "name" "Truck A"
    attr 101 "cost_per_km" 0.8
    attr 101 "urgency_score" 90

    record 102 type "item" category "Vehicles" status "active"
    attr 102 "name" "Van B"
    attr 102 "cost_per_km" 0.5
    attr 102 "urgency_score" 40

    record 103 type "item" category "Vehicles" status "active"
    attr 103 "name" "SUV C"
    attr 103 "cost_per_km" 1.2
    attr 103 "urgency_score" 95

    record 104 type "item" category "Vehicles" status "active"
    attr 104 "name" "Sedan D"
    attr 104 "cost_per_km" 1.0
    attr 104 "urgency_score" 50

    // Excluded by selector — wrong category.
    record 105 type "item" category "Equipment" status "active"
    attr 105 "name" "Forklift"
    attr 105 "cost_per_km" 0.3
    attr 105 "urgency_score" 99

    // Excluded by selector — inactive.
    record 106 type "item" category "Vehicles" status "inactive"
    attr 106 "name" "Retired Bus"
    attr 106 "cost_per_km" 0.4
    attr 106 "urgency_score" 80
  }

  when combine "Dispatch picks"

  expect {
    flagged 101
    flagged 102
    flagged 103
    not flagged 104
    not flagged 105
    not flagged 106
  }
}
