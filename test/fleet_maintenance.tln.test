// Fleet maintenance test suite.
//
// Run:
//   go build ./cmd/talon
//   ./talon test examples/fleet_maintenance.tln examples/fleet_maintenance.tln.test

test "Overdue service flags only overdue vehicles" {
  given {
    record 501 type "item" category "Vehicles" status "active"
    attr 501 "km" 45000
    attr 501 "last_service_km" 20000
    attr 501 "name" "Truck A"

    record 502 type "item" category "Vehicles" status "active"
    attr 502 "km" 25000
    attr 502 "last_service_km" 25000
    attr 502 "name" "Van B"

    record 503 type "item" category "Vehicles" status "inactive"
    attr 503 "km" 80000
    attr 503 "last_service_km" 10000
    attr 503 "name" "Retired Truck"

    record 504 type "stock_item" status "active"
    attr 504 "km" 99999
    attr 504 "last_service_km" 0
    attr 504 "name" "Brake Pads"

    record 505 type "item" category "Vehicles" status "active"
    attr 505 "km" 12000
    attr 505 "last_service_km" 11000
    attr 505 "name" "Car C"
  }

  when detect "Service overdue"

  expect {
    flagged 501
    not flagged 502
    not flagged 503
    not flagged 504
    flagged 505
  }
}

test "Assignment block applies to all active items" {
  given {
    record 601 type "item" status "active"
    attr 601 "name" "Forklift"

    record 602 type "item" status "inactive"
    attr 602 "name" "Retired Crane"

    record 603 type "item" status "active"
    attr 603 "name" "Excavator"

    record 604 type "stock_item" status "active"
    attr 604 "name" "Oil Filters"
  }

  when rule "No assignment during maintenance"

  expect {
    flagged 601
    not flagged 602
    flagged 603
    not flagged 604
  }
}

test "Manager approval applies only to active vehicles" {
  given {
    record 701 type "item" category "Vehicles" status "active"
    attr 701 "name" "Truck A"

    record 702 type "item" category "Vehicles" status "inactive"
    attr 702 "name" "Old Van"

    record 703 type "item" category "Equipment" status "active"
    attr 703 "name" "Generator"

    record 704 type "stock_item" status "active"
    attr 704 "name" "Spare Tires"
  }

  when rule "Manager approval for high value"

  expect {
    flagged 701
    not flagged 702
    not flagged 703
    not flagged 704
  }
}

test "Anomaly detection flags only outlier consumption" {
  // Eight stock_items with weekly_consumption: seven cluster around 50, one
  // spikes to 250. With n=8 and default z=2.5 the spike is the only flagged
  // row; smaller samples don't have enough degrees of freedom to exceed 2.5σ
  // on a single outlier.
  given {
    record 801 type "stock_item" status "active"
    attr 801 "name" "Brake Pads"
    attr 801 "weekly_consumption" 48

    record 802 type "stock_item" status "active"
    attr 802 "name" "Oil Filters"
    attr 802 "weekly_consumption" 51

    record 803 type "stock_item" status "active"
    attr 803 "name" "Air Filters"
    attr 803 "weekly_consumption" 49

    record 804 type "stock_item" status "active"
    attr 804 "name" "Spark Plugs"
    attr 804 "weekly_consumption" 50

    record 805 type "stock_item" status "active"
    attr 805 "name" "Cabin Filters"
    attr 805 "weekly_consumption" 49

    record 806 type "stock_item" status "active"
    attr 806 "name" "Fuel Filters"
    attr 806 "weekly_consumption" 50

    record 807 type "stock_item" status "active"
    attr 807 "name" "Belts"
    attr 807 "weekly_consumption" 51

    record 808 type "stock_item" status "active"
    attr 808 "name" "Wiper Blades"
    attr 808 "weekly_consumption" 250

    // Excluded by selector — wrong record type.
    record 809 type "item" status "active"
    attr 809 "name" "Truck A"
    attr 809 "weekly_consumption" 999
  }

  when detect "Unusual consumption"

  expect {
    not flagged 801
    not flagged 802
    not flagged 803
    not flagged 804
    not flagged 805
    not flagged 806
    not flagged 807
    flagged 808
    not flagged 809
    score 808 > 2.5
    threshold == 2.5
  }
}

test "Parts stock-out only considers active stock" {
  given {
    record 901 type "stock_item" status "active"
    attr 901 "name" "Brake Pads"
    attr 901 "current_stock" 15

    record 902 type "stock_item" status "inactive"
    attr 902 "name" "Old Gaskets"
    attr 902 "current_stock" 5

    record 903 type "item" status "active"
    attr 903 "name" "Truck A"

    record 904 type "stock_item" status "active"
    attr 904 "name" "Oil Filters"
    attr 904 "current_stock" 200
  }

  when forecast "Parts stock-out"

  expect {
    flagged 901
    not flagged 902
    not flagged 903
    flagged 904
  }
}
