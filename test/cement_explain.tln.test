// Tier-1 explainability fixture. Run with:
//
//   ./tln explain examples/cement_explain.tln test/cement_explain.tln.test

test "Cement scenario" {
  given {
    record 808 type "stock_item" status "active"
    attr 808 "name" "Portland Cement 50kg"
    attr 808 "current_stock" 12
    attr 808 "minimum_amount" 50

    record 809 type "stock_item" status "active"
    attr 809 "name" "Rebar 12mm"
    attr 809 "current_stock" 200
    attr 809 "minimum_amount" 50
  }
  when recommend "Order cement"
  expect {
    // Tier-1 explain demo — assertions intentionally minimal.
    // The `tln test` runner does not populate `flagged` for recommend
    // blocks (their plan is a GoComputation chain, no DatalevinQuery).
    // The user-facing assertion is the `tln explain` output itself.
  }
}
