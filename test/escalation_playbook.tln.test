// Test suite for escalation_playbook.tln — control flow in a remediate body.
//
// Run:
//   go build ./cmd/tln
//   ./tln test examples/escalation_playbook.tln test/escalation_playbook.tln.test

test "Critical overdue vehicle pages on-call; both branches and the loop fire" {
  given {
    // Overdue (50000 > 20000 + 20000) and CRITICAL → the `if` branch pages.
    record 1 type "vehicle"
    attr 1 "km" 50000
    attr 1 "last_service_km" 20000
    attr 1 "priority" "CRITICAL"

    // Overdue (45000 > 40000) but HIGH → the `else` branch opens a ticket.
    record 2 type "vehicle"
    attr 2 "km" 45000
    attr 2 "last_service_km" 20000
    attr 2 "priority" "HIGH"

    // Not overdue (21000 < 40000) → not flagged, no remediation.
    record 3 type "vehicle"
    attr 3 "km" 21000
    attr 3 "last_service_km" 20000
    attr 3 "priority" "CRITICAL"
  }

  mock mcp "ops" "page_oncall" { returns { paged 1 } }
  mock mcp "ops" "open_ticket" { returns { ticket 900 } }
  mock mcp "slack" "notify" { returns { ok 1 } }

  when detect "Overdue for service"

  expect {
    flagged 1
    flagged 2
    not flagged 3

    // `if` branch taken for the CRITICAL vehicle only.
    mcp_called "ops" "page_oncall" with { vehicle == 1 severity == "critical" }
    // `else` branch taken for the HIGH vehicle.
    mcp_called "ops" "open_ticket" with { vehicle == 2 }

    // `for each` fanned the notice to both channels.
    mcp_called "slack" "notify" with { channel == "fleet-ops" }
    mcp_called "slack" "notify" with { channel == "maintenance" }
  }
}
