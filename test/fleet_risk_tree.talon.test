// Test suite for fleet_risk_tree.talon — predict via an inline fitted tree.
//
// Tree: node0 km<=30000 → low(1.0) | node2; node2 age<=5 → low(0.8) | high(1.0).
// The confidence >= 0.9 gate keeps only decisive leaves (purity ≥ 0.9), so the
// low-purity leaf (node3) is dropped — proving both the traversal and the
// per-leaf purity gate run off the inline tree.
//
// Run:
//   go build ./cmd/talon
//   ./talon test examples/fleet_risk_tree.talon test/fleet_risk_tree.talon.test

test "decision-tree model classifies open vehicles by risk" {
  given {
    // km>30000, age>5 → node4 "high" purity 1.0 → flagged.
    record 1 type "vehicle" status "open"
    attr 1 "km" 50000
    attr 1 "age" 8

    // km<=30000 → node1 "low" purity 1.0 → flagged.
    record 2 type "vehicle" status "open"
    attr 2 "km" 10000
    attr 2 "age" 2

    // km>30000, age<=5 → node3 "low" purity 0.8 → below 0.9 → dropped.
    record 3 type "vehicle" status "open"
    attr 3 "km" 50000
    attr 3 "age" 4
  }

  when predict "Vehicle failure risk (tree)"

  expect {
    flagged 1
    flagged 2
    not flagged 3
  }
}
