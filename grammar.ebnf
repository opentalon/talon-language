(* Talon Language Grammar — EBNF
   Notation: [ x ] = optional, { x } = zero or more, ( x | y ) = alternation.
   Terminal tokens are UPPER_CASE or quoted strings.
   This file is the canonical grammar reference for the lexer and parser. *)

(* ─── Top level ──────────────────────────────────────────────────────────────── *)

Program   = { Block } EOF

Block     = DetectBlock
          | RuleBlock
          | RecommendBlock
          | CombineBlock
          | DefineBlock
          | WorkflowBlock
          | PredictBlock
          | ForecastBlock
          | ClusterBlock
          | ClassifyBlock
          | SimilarBlock
          | RelatedBlock
          | OnBlock
          | ConstraintBlock
          | EnrichBlock
          | CollectBlock

(* ─── collect ────────────────────────────────────────────────────────────────── *)

(* collect declares scheduled, host-driven MCP fact ingestion. Talon runs
   no scheduler: `schedule` is metadata a host cron reads via
   `talon collect list`, and the host fires `talon collect run` on time.
   The `cron "<expr>"` escape hatch replaces the RFC's `@cron` (`@` isn't
   tokenised). Response items are asserted as records of the store type. *)
CollectBlock  = "collect" STRING "{"
                  "schedule" ScheduleExpr
                  MCPCall
                  StoreClause
                "}"
ScheduleExpr  = "weekly" | "daily" | "hourly"
              | "every" NUMBER ( "hours" | "days" )
              | "cron" STRING
StoreClause   = "store" "results" "as" IDENT [ "tag" STRING ]

(* ─── enrich ─────────────────────────────────────────────────────────────────── *)

(* enrich refreshes stale facts from an MCP tool. For each selected record
   whose target attributes are older than the stale_after bound (per the
   FactStore Freshness capability), the runtime calls the MCP tool once and
   asserts the mapped response fields back. Host-driven — it runs when the
   program runs / an agent ticks it, not on fact reads. *)
EnrichBlock  = "enrich" STRING "{"
                 Selector
                 "stale_after" Duration
                 MCPCall
                 UpdateClause { UpdateClause }
               "}"
UpdateClause = "update" "attr" STRING "from" "result" "." IDENT { "." IDENT }

(* ─── detect ─────────────────────────────────────────────────────────────────── *)

DetectBlock = "detect" STRING "{" DetectBody "}"

DetectBody  = Selector
              [ FlagTarget ]
              [ LabelClause ]
              [ PriorityClause ]
              [ "when" Condition ]
              [ ConfidenceClause ]
              [ ScoreAnnotation ]
              [ SourceAnnotation ]
              { CalculateClause }
              { LoggerStmt }
              [ AnomalyClause ]
              [ PredictClause ]
              [ ForecastClause ]
              [ ClusterClause ]
              [ SimilarClause ]
              [ RelatedClause ]
              [ RemediateClause ]
              [ RecommendBlock ]

(* RemediateClause fires MCP calls as side effects when the block matches,
   once per flagged row, with each call's args resolved against that row's
   entity (attr "x" → typed value; string literals interpolate {item.x} /
   {attr.x} templates). Note: bare dotted refs like `item.id` are not
   expression syntax; use `attr "id"` or the template form "{item.id}".

   An optional mode controls how each call executes: auto (fire directly),
   propose (default — gate on the host ConfirmationHook), approve (gate on
   the host ApprovalHook for the named role), queue (defer to the host
   Queue under a batch name; never contacts MCP). *)
RemediateClause = "remediate" [ RemediateMode ] "{"
                    [ "requires" "role" STRING ]
                    [ "batch" STRING ]
                    { MCPCall }
                  "}"
RemediateMode   = "auto" | "propose" | "approve" | "queue"

(* ScoreAnnotation declares the rule's self-asserted confidence, intended
   for auto-discovered rules ("mined from data with score 0.82").
   Distinct from the ConfidenceClause filter on ML primitives — the
   filter form requires `>=`, the annotation form takes a bare NUMBER.
   See docs/spec/v0.2.md section 12. *)
ScoreAnnotation  = "confidence" NUMBER

(* SourceAnnotation records the provenance of an auto-discovered rule —
   typically the data set and time window it was mined from. *)
SourceAnnotation = "source" STRING

(* ─── rule ───────────────────────────────────────────────────────────────────── *)

(* A `strict` rule cannot be overridden. An `overrides` clause names one or
   more rules this rule defeats when both match. See docs/defeasible.md. *)
RuleBlock   = [ "strict" ] "rule" STRING "{" RuleBody "}"

RuleBody    = ( Selector | WhenClause )
              [ EveryClause ]
              [ BeforeClause | AfterClause ]
              [ OverridesClause ]
              ( BlockClause | AllowClause | RequiresClause )
              [ ReasonClause ]
              [ PriorityClause ]
              [ ScoreAnnotation ]
              [ SourceAnnotation ]
              { LoggerStmt }

OverridesClause = "overrides" STRING { "," STRING }

(* ─── recommend ──────────────────────────────────────────────────────────────── *)

RecommendBlock = "recommend" STRING "{" RecommendBody "}"

RecommendBody  = WhenClause
                 { CalculateClause }
                 SuggestClause
                 [ RemediateClause ]
                 [ PriorityClause ]
                 { LoggerStmt }

(* ─── combine ────────────────────────────────────────────────────────────────── *)

CombineBlock = "combine" STRING "{" CombineBody "}"

CombineBody  = Selector
               OptimizeClause { OptimizeClause }
               ReturnClause
               [ LabelClause ]
               [ PriorityClause ]

(* ─── define ─────────────────────────────────────────────────────────────────── *)

DefineBlock  = "define" STRING [ "(" ParamList ")" ] "{" DefineBody "}"

DefineBody   = { Condition | ForEachClause }

ParamList    = IDENT { "," IDENT }

ForEachClause = "for" "each" IDENT "in" IDENT "{" { Condition } "}"

(* ─── workflow ───────────────────────────────────────────────────────────────── *)

WorkflowBlock = "workflow" STRING "{" { WorkflowStep } "}"

WorkflowStep  = "step" STRING
                [ "depends_on" ( STRING | "[" STRING { "," STRING } "]" ) ]
                "{" StepBody "}"

StepBody      = MCPCall { Condition }

MCPCall       = "mcp" STRING STRING "{" { MCPArg | OnErrorClause } "}"

MCPArg        = IDENT Expr

(* on_error is a per-call resilience policy. Actions run left-to-right:
   `retry N times` makes N extra attempts (fixed-interval, no backoff in
   v1); `log "msg"` writes a structured line ({error} + row context);
   `skip` swallows the failure and continues; `fail` propagates it (the
   implicit default when no skip/fail is present). `then` is optional. *)
OnErrorClause = "on_error" "{" { ErrorAction } "}"
ErrorAction   = [ "then" ] ( "retry" NUMBER [ "times" ] | "log" STRING | "skip" | "fail" )

(* ─── top-level ML blocks ────────────────────────────────────────────────────── *)

(* predict and forecast can also appear as nested clauses inside detect.
   When appearing at top level they are standalone named blocks. *)

PredictBlock  = "predict" STRING "{" PredictBody "}"

PredictBody   = Selector
                FeaturesClause
                [ TrainedOnClause ]
                [ ConfidenceClause ]
                [ LabelClause ]
                [ PriorityClause ]

ForecastBlock = "forecast" STRING "{" ForecastBody "}"

ForecastBody  = Selector
                SeriesClause
                [ "predict" ForecastPredictExpr ]
                [ WhenClause ]
                [ LabelClause ]
                [ PriorityClause ]

ClusterBlock  = "cluster" STRING "{" ClusterBody "}"

ClusterBody   = Selector
                "by" AttrList
                [ LabelClause ]
                [ PriorityClause ]

ClassifyBlock = "classify" STRING "{" ClassifyBody "}"

ClassifyBody  = Selector
                FeaturesClause
                [ ConfidenceClause ]
                [ LabelClause ]
                [ PriorityClause ]

SimilarBlock  = "find" "similar" STRING "{" SimilarBody "}"

SimilarBody   = Selector
                "to" Expr
                [ "within" NUMBER ]
                [ LabelClause ]
                [ PriorityClause ]

(* PPR-over-facts: associative-memory retrieval. See
   docs/design/0002-ppr-fact-graph.md. *)
RelatedBlock  = "find" "related" STRING "{" RelatedBody "}"

RelatedBody   = Selector
                ( "to" Expr | "seeds" "[" ExprList "]" )
                [ "top_k" NUMBER ]
                [ "damping" NUMBER ]
                [ "tolerance" NUMBER ]
                [ "max_iterations" NUMBER ]
                [ LabelClause ]
                [ PriorityClause ]

ExprList      = Expr { "," Expr }

(* ─── on (reactive rules) ───────────────────────────────────────────────────── *)

(* Reactive rules fire when a fact changes, not on schedule or request.
   See docs/reactive.md. The body is a list of side-effect statements; the
   minimal grammar supports logger calls and named references to other blocks. *)
OnBlock     = "on" OnTrigger "{" OnBody "}"

OnTrigger   = "change" "attr" STRING [ "to" Expr ]
            | "assert" IDENT
            | "retract" IDENT

OnBody      = [ WhenClause ] { OnAction }

OnAction    = LoggerStmt
            | "recommend" STRING
            | "detect" STRING
            | "workflow" STRING

LoggerStmt  = "logger" "." ( "info" | "warn" | "error" ) Template

(* ─── constraint (integrity constraints) ────────────────────────────────────── *)

(* Constraints run on every fact mutation and reject/warn/quarantine violators.
   See docs/constraints.md. *)
ConstraintBlock = "constraint" STRING "{" ConstraintBody "}"

ConstraintBody  = Selector
                  RequireClause
                  OnViolationClause

RequireClause       = "require" Condition

OnViolationClause   = "on_violation" ViolationMode [ STRING ]

ViolationMode       = "reject" | "warn" | "quarantine"

(* ─── Nested ML clauses (inside detect) ─────────────────────────────────────── *)

AnomalyClause   = "is" "anomaly" "compared_to" "last" NUMBER DurationUnit

PredictClause   = "predict" FeaturesClause [ TrainedOnClause ] [ ConfidenceClause ]

ForecastClause  = "forecast" SeriesClause [ "predict" ForecastPredictExpr ]

ClusterClause   = "cluster" "by" AttrList

SimilarClause   = "find" "similar" "to" Expr [ "within" NUMBER ]

RelatedClause   = "find" "related"
                  ( "to" Expr | "seeds" "[" ExprList "]" )
                  [ "top_k" NUMBER ]
                  [ "damping" NUMBER ]

(* ─── Shared clauses ─────────────────────────────────────────────────────────── *)

Selector        = "for" "records" "where" ConditionList

WhenClause      = "when" ConditionList

FlagTarget      = "flag" "matching" ( "items" | "records" | IDENT )

LabelClause     = "label" Template

PriorityClause  = "priority" ( "LOW" | "MEDIUM" | "HIGH" | "CRITICAL" )

ConfidenceClause = "confidence" ">=" NUMBER

EveryClause     = "every" NUMBER ( DurationUnit | IDENT ) "on" "attr" STRING

BeforeClause    = "before" STRING [ "when" ConditionList ]

AfterClause     = "after" STRING

BlockClause     = "block" [ STRING ] [ ReasonClause ]

AllowClause     = "allow" STRING

RequiresClause  = "requires" ( STRING | ApprovalExpr )

ApprovalExpr    = "approval" "from" "role" STRING

ReasonClause    = "reason" Template

SuggestClause   = "suggest" Template

OptimizeClause  = ( "minimize" | "maximize" ) Expr

ReturnClause    = "return" IDENT { "," IDENT }

CalculateClause = "calculate" IDENT "from" ( "activities" | "records" )
                  [ "where" ConditionList ]
                  [ "within" "last" NUMBER DurationUnit ]

FeaturesClause  = "features" "[" AttrList "]"

TrainedOnClause = "trained_on" "records" "where" ConditionList

SeriesClause    = "series" Expr "over" "last" NUMBER DurationUnit

ForecastPredictExpr = IDENT "value" ComparisonOp Expr

AttrList        = Expr { "," Expr }

(* ─── Conditions ─────────────────────────────────────────────────────────────── *)

ConditionList   = Condition { ( "and" | "or" ) Condition }

Condition       = NotCondition
                | CompareCondition
                | MembershipCondition
                | IsCondition
                | HasCondition
                | StringMatchCondition
                | AnomalyCondition
                | TemporalCondition
                | ChangedToCondition
                | SugarCondition

(* SugarConditions desugar at parse time to the forms above (no new AST):
     has_open record type "X"           → has record type "X"
                                            and attr "X.status" != "closed"
     has_expired record type "X" [where C] → has record type "X"
                                            and attr "X.expires_at" < today [and C]
     attr "X" approaching within N UNIT  → attr "X" >= today
                                            and attr "X" <= today + N UNIT
   NOTE: these compile but do NOT filter yet — the goCondition evaluators
   don't evaluate has/today/date-arithmetic/cross-record (they fail open).
   The evaluation is a separate follow-up; #62 ships the syntax + desugaring. *)
SugarCondition  = "has_open" [ "record" ] "type" STRING
                | "has_expired" [ "record" ] "type" STRING [ "where" Condition ]
                | Expr "approaching" "within" NUMBER DurationUnit

NotCondition        = "not" Condition

CompareCondition    = Expr ComparisonOp Expr

MembershipCondition = Expr [ "not" ] "in" ( "[" ValueList "]" | CategoryTreeExpr )

IsCondition         = ( Expr "is" STRING )
                    | ( "attr" STRING "is" "anomaly" "compared_to" "last" NUMBER DurationUnit )

HasCondition        = "has" "record" "type" STRING  (* open maintenance ticket, etc. *)

StringMatchCondition = Expr ( "contains" | "starts_with" | "ends_with"
                            | "matches" [ "phrase" ] ) STRING

AnomalyCondition    = "attr" STRING "is" "anomaly" "compared_to" "last" NUMBER DurationUnit

TemporalCondition   = "attr" STRING ( "older_than" | "newer_than" ) NUMBER DurationUnit

ChangedToCondition  = "status" "changed_to" STRING

CategoryTreeExpr    = "category_tree" "(" STRING ")"

(* ─── Expressions ────────────────────────────────────────────────────────────── *)

Expr        = BinaryExpr | UnaryExpr | PrimaryExpr

BinaryExpr  = Expr ArithOp Expr

UnaryExpr   = "-" PrimaryExpr

PrimaryExpr = AttrRef
            | ContextRef
            | StepRef
            | CategoryTreeExpr
            | "today"
            | Literal
            | IDENT
            | "(" Expr ")"

AttrRef     = "attr" STRING

ContextRef  = "context" "." IDENT

StepRef     = "step" "(" STRING ")" "." IDENT { "." IDENT }

Literal     = STRING | NUMBER | BOOLEAN | Duration

Duration    = NUMBER DurationUnit

DurationUnit = "days" | "weeks" | "months" | "years" | "km"

ValueList   = Literal { "," Literal }

Template    = STRING
              (* STRING may contain {ident}, {ident.field}, {attr.name},
                 {confidence}, {avg}, {days_until} interpolations *)

ComparisonOp = "==" | "!=" | ">" | "<" | ">=" | "<="

ArithOp     = "+" | "-" | "*" | "/" | "%"

BOOLEAN     = "true" | "false"

(* ─── Tokens ─────────────────────────────────────────────────────────────────── *)

STRING  = '"' { CHAR | ESCAPE | INTERPOLATION } '"'

INTERPOLATION = "{" IDENT_PATH "}"

IDENT_PATH = IDENT { "." IDENT }

NUMBER  = DIGIT { DIGIT } [ "." DIGIT { DIGIT } ]

IDENT   = LETTER { LETTER | DIGIT | "_" }

LETTER  = "a" ... "z" | "A" ... "Z" | "_"

DIGIT   = "0" ... "9"

CHAR    = (* any Unicode character except '"' and '\' *)

ESCAPE  = "\" ( '"' | "\" | "n" | "t" | "r" )

COMMENT = ( "//" { CHAR } NEWLINE )
        | ( "/*" { CHAR } "*/" )

EOF     = (* end of input *)
